---
const {url, title} = Astro.props;
---
<div class="article-share" data-article-share data-url={url} data-title={title}>
  <div class="article-share-buttons" role="group" aria-label="Share this article">
    <button class="article-share-tool" type="button" aria-label="Share article" data-share hidden><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 16V3m-5 5 5-5 5 5M5 13v7h14v-7"/></svg>Share</button>
    <button class="article-share-tool" type="button" data-copy hidden><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V4H4v12h4"/></svg>Copy link</button>
  </div>
  <p class="article-share-status" role="status" aria-live="polite" data-status></p>
  <input class="article-share-url" type="url" readonly aria-label="Article link" value={url} hidden />
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-article-share]').forEach((root) => {
    const url = root.dataset.url!;
    const title = root.dataset.title!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const input = root.querySelector<HTMLInputElement>('input')!;
    const share = root.querySelector<HTMLButtonElement>('[data-share]')!;
    const copy = root.querySelector<HTMLButtonElement>('[data-copy]')!;
    share.hidden = copy.hidden = false;
    async function copyLink() {
      input.hidden = true;
      try {
        await navigator.clipboard.writeText(url);
        status.textContent = 'Link copied.';
      } catch {
        input.hidden = false;
        input.focus();
        input.select();
        status.textContent = 'Copy the article link below.';
      }
    }
    copy.addEventListener('click', copyLink);
    share.addEventListener('click', async () => {
      status.textContent = '';
      input.hidden = true;
      if (!navigator.share) return copyLink();
      try {
        await navigator.share({title, url});
      } catch (error) {
        if (error instanceof DOMException && error.name === 'AbortError') return;
        await copyLink();
      }
    });
  });
</script>
