[Unit]
Description=Submit explicitly approved Cold Boot article revisions
[Service]
Type=oneshot
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
WorkingDirectory=%h/repos/cjski-website-publisher
EnvironmentFile=%h/.config/cold-boot/publisher.env
ExecStartPre=/usr/bin/env node -e "if (Number(process.versions.node.split('.')[0]) !== 24) process.exit(1); console.log('Website publisher runtime ' + process.version)"
ExecStart=/usr/bin/env node scripts/blog/worker.mjs
